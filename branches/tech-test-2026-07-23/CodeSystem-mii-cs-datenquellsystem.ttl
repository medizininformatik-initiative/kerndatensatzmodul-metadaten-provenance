  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: CodeSystem mii-cs-datenquellsystem</b></p><a name=\"mii-cs-datenquellsystem\"> </a><a name=\"hcmii-cs-datenquellsystem\"> </a><div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\"/><p style=\"margin-bottom: 0px\">Profile: <a href=\"http://hl7.org/fhir/uv/crmi/STU2/StructureDefinition-shareablecodesystem.html\">Shareable CodeSystem</a></p></div><p>This case-sensitive code system <code>https://www.medizininformatik-initiative.de/fhir/ext/modul-metadaten-provenance/CodeSystem/mii-cs-datenquellsystem</code> defines the following codes in a Is-A hierarchy:</p><table class=\"codes\"><tr><td><b>Lvl</b></td><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td>1</td><td style=\"white-space:nowrap\">Primaersystem<a name=\"mii-cs-datenquellsystem-Primaersystem\"> </a></td><td>Primärsystem</td><td>System der Primärerfassung am Ort der Versorgung — Daten entstehen hier zum ersten Mal.</td></tr><tr><td>2</td><td style=\"white-space:nowrap\">  KIS<a name=\"mii-cs-datenquellsystem-KIS\"> </a></td><td>Krankenhausinformationssystem</td><td>Zentrales klinisches Informationssystem des Krankenhauses (Aufnahme, Verlegung, Entlassung, Doku).</td></tr><tr><td>2</td><td style=\"white-space:nowrap\">  Tumordoku<a name=\"mii-cs-datenquellsystem-Tumordoku\"> </a></td><td>Tumordokumentationssystem</td><td>Spezialsystem zur klinischen Tumordokumentation.</td></tr><tr><td>2</td><td style=\"white-space:nowrap\">  LIS<a name=\"mii-cs-datenquellsystem-LIS\"> </a></td><td>Laborinformationssystem</td><td>System zur Verwaltung von Laborbefunden und -anforderungen.</td></tr><tr><td>2</td><td style=\"white-space:nowrap\">  RIS<a name=\"mii-cs-datenquellsystem-RIS\"> </a></td><td>Radiologie-Informationssystem</td><td>System zur Verwaltung radiologischer Befunde und Untersuchungen.</td></tr><tr><td>2</td><td style=\"white-space:nowrap\">  PACS<a name=\"mii-cs-datenquellsystem-PACS\"> </a></td><td>Picture Archiving and Communication System</td><td>Bildarchivierungssystem (Radiologie, Pathologie etc.).</td></tr><tr><td>2</td><td style=\"white-space:nowrap\">  OP_Doku<a name=\"mii-cs-datenquellsystem-OP_Doku\"> </a></td><td>OP-Dokumentationssystem</td><td>Dokumentationssystem für operative Eingriffe.</td></tr><tr><td>1</td><td style=\"white-space:nowrap\">Sekundaersystem<a name=\"mii-cs-datenquellsystem-Sekundaersystem\"> </a></td><td>Sekundärsystem</td><td>System, das Daten aus Primärsystemen aufnimmt oder transformiert (zweckgebunden aufbereitet).</td></tr><tr><td>2</td><td style=\"white-space:nowrap\">  Abrechnungssystem<a name=\"mii-cs-datenquellsystem-Abrechnungssystem\"> </a></td><td>Abrechnungssystem</td><td>System oder Subsystem zur Erstellung von Abrechnungs- und DRG-Datensätzen (§21 KHEntgG, §301 SGB V).</td></tr><tr><td>2</td><td style=\"white-space:nowrap\">  DRG_Grouper<a name=\"mii-cs-datenquellsystem-DRG_Grouper\"> </a></td><td>DRG-Grouper</td><td>System zur DRG-/PEPP-Klassifikation.</td></tr><tr><td>2</td><td style=\"white-space:nowrap\">  DWH<a name=\"mii-cs-datenquellsystem-DWH\"> </a></td><td>Data Warehouse</td><td>Konsolidiertes Datenarchiv für Auswertung und Reporting.</td></tr><tr><td>2</td><td style=\"white-space:nowrap\">  Forschungsdaten<a name=\"mii-cs-datenquellsystem-Forschungsdaten\"> </a></td><td>Forschungsdaten- / DIZ-System</td><td>Forschungsdaten-Plattform oder Datenintegrationszentrum (z. B. MII-DIZ-Repository).</td></tr><tr><td>2</td><td style=\"white-space:nowrap\">  Krebsregister<a name=\"mii-cs-datenquellsystem-Krebsregister\"> </a></td><td>Krebsregister</td><td>Klinisches oder epidemiologisches Krebsregister.</td></tr></table></div>"
  ] ;
