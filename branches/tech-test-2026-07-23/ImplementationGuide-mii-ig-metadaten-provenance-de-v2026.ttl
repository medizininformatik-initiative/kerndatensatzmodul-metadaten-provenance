         fhir:link <https://www.medizininformatik-initiative.de/fhir/ext/modul-metadaten-provenance/CodeSystem/mii-cs-provenance-prozedur-herkunft> ;
         fhir:Reference.reference [ fhir:value "CodeSystem/mii-cs-provenance-prozedur-herkunft" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "MII CS Provenance Prozedur Herkunft" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "CodeSystem für die Herkunft onkologischer Prozeduren zur Unterscheidung von Datenquellen und Deduplizierungsstatus." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
